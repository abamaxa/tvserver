<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Keep native settings aligned with the library palette in src/theme.ts. -->
    <color name="settings_background">#0A0E14</color>
    <color name="settings_panel">#171F2B</color>
    <color name="settings_raised">#202B39</color>
    <color name="settings_border">#293544</color>
    <color name="settings_text">#F3F7FB</color>
    <color name="settings_muted">#B8C2CF</color>
    <color name="settings_mint">#8CE4CD</color>
    <color name="settings_ink">#10231F</color>
    <color name="settings_danger">#FF8787</color>
    <color name="settings_ripple">#268CE4CD</color>

    <style name="Theme.LotsOfVideos.Settings" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/settings_background</item>
        <item name="android:colorBackground">@color/settings_background</item>
        <item name="android:statusBarColor">@color/settings_background</item>
        <item name="android:navigationBarColor">@color/settings_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/settings_text</item>
        <item name="android:textColorSecondary">@color/settings_muted</item>
        <item name="colorPrimary">@color/settings_mint</item>
        <item name="colorPrimaryVariant">@color/settings_mint</item>
        <item name="colorOnPrimary">@color/settings_ink</item>
        <item name="colorSecondary">@color/settings_mint</item>
        <item name="colorOnSecondary">@color/settings_ink</item>
        <item name="colorSurface">@color/settings_panel</item>
        <item name="colorOnSurface">@color/settings_text</item>
        <item name="colorAccent">@color/settings_mint</item>
        <item name="colorControlNormal">@color/settings_muted</item>
        <item name="colorControlActivated">@color/settings_mint</item>
        <item name="colorError">@color/settings_danger</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.LotsOfVideos.Settings.Dialog</item>
    </style>

    <style name="ThemeOverlay.LotsOfVideos.Settings.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/settings_panel</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="textColorAlertDialogListItem">@color/settings_text</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.LotsOfVideos.Settings.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Widget.LotsOfVideos.Settings.DialogBody</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.LotsOfVideos.Settings.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.LotsOfVideos.Settings.Confirm</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.LotsOfVideos.Settings.Cancel</item>
        <item name="alertDialogStyle">@style/Widget.LotsOfVideos.Settings.Dialog</item>
    </style>

    <style name="ShapeAppearance.LotsOfVideos.Settings.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.LotsOfVideos.Settings.Dialog" parent="MaterialAlertDialog.MaterialComponents">
        <item name="backgroundTint">@color/settings_panel</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.LotsOfVideos.Settings.Dialog</item>
    </style>

    <style name="Widget.LotsOfVideos.Settings.DialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/settings_text</item>
    </style>

    <style name="Widget.LotsOfVideos.Settings.DialogBody" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/settings_muted</item>
    </style>

    <style name="Widget.LotsOfVideos.Settings.Cancel" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/settings_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="Widget.LotsOfVideos.Settings.Confirm" parent="Widget.LotsOfVideos.Settings.Cancel">
        <item name="android:textColor">@color/settings_ink</item>
        <item name="backgroundTint">@color/settings_mint</item>
    </style>
</resources>
